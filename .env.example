# Copy to .env and change the passwords. Never commit the real .env file.
DB_NAME=stockspot
DB_USER=stockspot
DB_PASS=change_me_app_password
DB_ROOT_PASS=change_me_root_password
# Production only (docker-compose.prod.yml): public hostname that Caddy serves over HTTPS,
# e.g. stockspot-yourname.southeastasia.cloudapp.azure.com
SITE_ADDRESS=localhost
